<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= title %> | Ladywood Food Banks</title>
	<link rel="stylesheet" href="/css/stylesheet.css">
</head>
<body>

<%- include('../partials/header') %>

<main>
	<h1>Dashboard — <%= foodbank ? foodbank.name : 'Your Food Bank' %></h1>
	<p>Manage your stock levels below.</p>

	<!-- Current stock table -->
	<h2>Current Stock</h2>
	<% if (listings.length === 0) { %>
		<p>No items listed yet.</p>
	<% } else { %>
		<table class="stock-table">
			<caption class="sr-only">Current stock items</caption>
			<thead>
				<tr>
					<th scope="col">Item</th>
					<th scope="col">Quantity</th>
					<th scope="col">Unit</th>
					<th scope="col">Actions</th>
				</tr>
			</thead>
			<tbody>
				<% listings.forEach(item => { %>
				<tr>
					<td><%= item.item_name %></td>
					<td>
						<form action="/admin/stock/edit/<%= item.id %>" method="POST">
							<label class="sr-only" for="quantity-<%= item.id %>">Quantity for <%= item.item_name %></label>
							<input id="quantity-<%= item.id %>" class="stock-quantity" type="number" name="quantity" value="<%= item.quantity %>" min="0">
							<fieldset class="tag-options">
								<legend>Tags for <%= item.item_name %></legend>
								<% tags.forEach(tag => { %>
									<label>
										<input type="checkbox" name="tag_ids" value="<%= tag.id %>"
											<%= item.tag_ids.includes(tag.id) ? 'checked' : '' %>>
										<%= tag.tag_name %>
									</label>
								<% }) %>
							</fieldset>
							<button class="save-button" type="submit" aria-label="Save <%= item.item_name %>">Save</button>
						</form>
					</td>
					<td><%= item.unit || '—' %></td>
					<td>
						<form action="/admin/stock/delete/<%= item.id %>" method="POST"
							onsubmit="return confirm('Delete this item?')">
							<button class="delete-button" type="submit" aria-label="Delete <%= item.item_name %>">Delete</button>
						</form>
					</td>
				</tr>
				<% }) %>
			</tbody>
		</table>
	<% } %>

	<!-- Add new item -->
	<h2 class="section-heading">Add New Item</h2>
	<form action="/admin/stock/add" method="POST">
		<label for="new-item-name">Item name</label>
		<input id="new-item-name" type="text" name="item_name" placeholder="e.g. Baked Beans" required>
		<label for="new-item-quantity">Quantity</label>
		<input id="new-item-quantity" type="number" name="quantity" min="0" required>
		<label for="new-item-unit">Unit optional</label>
		<input id="new-item-unit" type="text" name="unit" placeholder="e.g. tins, kg">
		<fieldset class="tag-options">
			<legend>Tags</legend>
			<% tags.forEach(tag => { %>
				<label>
					<input type="checkbox" name="tag_ids" value="<%= tag.id %>">
					<%= tag.tag_name %>
				</label>
			<% }) %>
		</fieldset>
		<button type="submit">Add Item</button>
	</form>

	<br>
	<a href="/admin/logout">Log out</a>
</main>

<%- include('../partials/footer') %>

<script src="/js/app.js"></script>
</body>
</html>
