<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/stylesheet.css">
</head>
<body>

<%- include('../partials/header') %>

<main>
    <h1>Dashboard — <%= foodbank ? foodbank.name : 'Your Food Bank' %></h1>
    <p>Manage your stock levels below.</p>

    <!-- Current stock table -->
    <h2>Current Stock</h2>
    <% if (listings.length === 0) { %>
        <p>No items listed yet.</p>
    <% } else { %>
        <table style="width:100%; border-collapse: collapse;">
            <thead>
                <tr style="background:#7b1e5a; color:white;">
                    <th style="padding:10px; text-align:left;">Item</th>
                    <th style="padding:10px; text-align:left;">Quantity</th>
                    <th style="padding:10px; text-align:left;">Unit</th>
                    <th style="padding:10px; text-align:left;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% listings.forEach(item => { %>
                <tr style="border-bottom: 1px solid #ddd;">
    <td style="padding:10px;"><%= item.item_name %></td>
    <td style="padding:10px;">
        <form action="/admin/stock/edit/<%= item.id %>" method="POST">
            <input type="number" name="quantity" value="<%= item.quantity %>" min="0"
                style="width:80px; padding:6px; margin-bottom:8px;">
            <div>
                <% tags.forEach(tag => { %>
                    <label style="margin-right:10px;">
                        <input type="checkbox" name="tag_ids" value="<%= tag.id %>"
                            <%= item.tag_ids.includes(tag.id) ? 'checked' : '' %>>
                        <%= tag.tag_name %>
                    </label>
                <% }) %>
            </div>
            <button type="submit" style="margin-top:8px;">Save</button>
        </form>
    </td>
    <td style="padding:10px;"><%= item.unit || '—' %></td>
    <td style="padding:10px;">
        <form action="/admin/stock/delete/<%= item.id %>" method="POST"
            onsubmit="return confirm('Delete this item?')">
            <button type="submit" style="background:#c0392b;">Delete</button>
        </form>
    </td>
</tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>

    <!-- Add new item -->
    <h2 style="margin-top:40px;">Add New Item</h2>
    <form action="/admin/stock/add" method="POST">
        <input type="text" name="item_name" placeholder="Item name (e.g. Baked Beans)" required>
        <input type="number" name="quantity" placeholder="Quantity" min="0" required>
        <input type="text" name="unit" placeholder="Unit (e.g. tins, kg) — optional">
        <div style="margin-bottom:15px;">
            <strong>Tags:</strong><br>
            <% tags.forEach(tag => { %>
                <label style="margin-right:10px;">
                    <input type="checkbox" name="tag_ids" value="<%= tag.id %>">
                    <%= tag.tag_name %>
                </label>
            <% }) %>
        </div>
        <button type="submit">Add Item</button>
    </form>

    <br>
    <a href="/admin/logout">Log out</a>
</main>

<%- include('../partials/footer') %>

</body>
</html>