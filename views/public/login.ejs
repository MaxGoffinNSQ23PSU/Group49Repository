<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= title %> | Ladywood Food Banks</title>
	<link rel="stylesheet" href="/css/stylesheet.css">
</head>
<body>

<%- include('../partials/header') %>

<main>
		
		<h1 class="centered-title"><%= title %></h1>
		<div class="container">
			<form class="loginBox" action="/login" method="POST">
				<label for="login">Email</label>
				<input type="email" id="login" name="email" autocomplete="email" required>
				<label for="password">Password</label>
				<input type="password" id="password" name="password" autocomplete="current-password" required>
				<input type="submit" id="LoginButton" class="btn" value="Login">
			</form>
		</div>
</main>

<%- include('../partials/footer') %>

<script src="/js/app.js"></script>
</body>
</html>
