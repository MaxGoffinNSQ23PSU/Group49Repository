<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= title %> | Ladywood Food Banks</title>
	<link rel="stylesheet" href="/css/stylesheet.css">
	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>

<%- include('../partials/header') %>

<main class="home">
	<h1>Food Banks in Ladywood, Birmingham</h1>
	<p>Find your nearest food bank. Click a pin to see details and available stock.</p>

		<div class="location-search">
			<label class="sr-only" for="address-input">Address or postcode</label>
			<input type="text" id="address-input" placeholder="Enter your address or postcode...">
			<button id="find-location" type="button">Find me</button>
		</div>

	<div class="map-wrapper">
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
		<div id="map"></div>

		<div id="details-panel" class="details-panel hidden" role="region" aria-labelledby="panel-title" tabindex="-1">
			<button id="close-panel" class="close-btn" type="button" aria-label="Close food bank details">✕</button>
			<div id="panel-content"></div>
		</div>
	</div>
</main>

<%- include('../partials/footer') %>

<script src="/js/app.js"></script>
<script src="/js/home.js"></script>
</body>
</html>
